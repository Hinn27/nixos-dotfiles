    layout {
        gaps 6 // Gap between windows
        center-focused-column "never"

        background-color "transparent"

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
    }

        struts 
    border {
        off

        width 2
    }
    focus-ring {
        off

        width 1
    }
}
